<?xml version="1.0" encoding="UTF-8"?>
<!--
  ~/.config/labwc/menu.xml  -  the menu you get by right-clicking the desktop.
  The window menu (right-click a title bar) is labwc's built-in one.
  Every option: man 5 labwc-menu. Reload with Ctrl+Shift+C.
-->
<openbox_menu>
  <menu id="root-menu">
    <item label="Apps…">
      <action name="Execute" command="fuzzel" />
    </item>
    <item label="Terminal">
      <action name="Execute" command="foot" />
    </item>
    <separator />
    <item label="Change wallpaper…">
      <action name="Execute" command="~/.config/labwc/scripts/wallpaper.sh" />
    </item>
    <item label="Display scale…">
      <action name="Execute" command="~/.config/labwc/scripts/scale.sh" />
    </item>
    <item label="Power &amp; sleep settings…">
      <action name="Execute" command="~/.config/labwc/scripts/power-settings.sh" />
    </item>
    <item label="Keyboard shortcuts…">
      <action name="Execute" command="~/.config/labwc/scripts/keybinds.sh" />
    </item>
    <item label="Reload settings">
      <action name="Reconfigure" />
      <action name="Execute" command="pkill -SIGUSR2 waybar" />
    </item>
    <separator />
    <item label="Lock">
      <action name="Execute" command="~/.config/labwc/scripts/lock.sh" />
    </item>
    <item label="Suspend">
      <action name="Execute" command="systemctl suspend" />
    </item>
    <item label="Log out">
      <action name="Exit" />
    </item>
    <item label="Reboot">
      <action name="Execute" command="systemctl reboot" />
    </item>
    <item label="Shut down">
      <action name="Execute" command="systemctl poweroff" />
    </item>
  </menu>
</openbox_menu>
